@inject DvCms.Contracts.Localizzazione.IContestoLingua ContestoLingua
<!DOCTYPE html>
<html lang="@ContestoLingua.CodiceLingua">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@(ViewData["Titolo"] is string titolo ? titolo + " - " : string.Empty)DvCms</title>
    <link href="~/lib/tabler/dashboard/dist/css/tabler.min.css" rel="stylesheet" />
    <link href="~/lib/tabler-icons/webfont/tabler-icons.min.css" rel="stylesheet" />
</head>
<body class="d-flex flex-column">
    <script src="~/lib/tabler/dashboard/dist/js/tabler-theme.min.js"></script>
    <div class="page page-center">
        <div class="container container-tight py-4">
            <div class="text-center mb-4">
                <span class="fs-1 fw-bold">DvCms</span>
            </div>
            @RenderBody()
        </div>
    </div>
    <script src="~/lib/tabler/dashboard/dist/js/tabler.min.js"></script>
</body>
</html>

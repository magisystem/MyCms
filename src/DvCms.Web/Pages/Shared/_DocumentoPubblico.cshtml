@model DvCms.Web.Pubblico.VistaPagina?
@{
    var vista = Model;
}
<!DOCTYPE html>
<html lang="@(vista?.CodiceLingua ?? "it")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(vista?.TitoloDocumento ?? _L["Pagina non trovata"])</title>
    @if (vista is { DescrizioneSeo: { } descrizione })
    {
        <meta name="description" content="@descrizione" />
    }
    <link rel="stylesheet" href="~/css/pubblico.css" />
    <link rel="stylesheet" href="~/css/componenti.css" asp-append-version="true" />
    @if (vista?.Documento is not null)
    {
        @* Animazioni dichiarative: file fidato del sito, piccolo e senza dipendenze; va in testa per marcare la pagina prima del primo disegno. *@
        <script src="~/js/animazioni.js" asp-append-version="true"></script>
    }
    @if (vista is not null)
    {
        <link rel="stylesheet" href="@DvCms.Web.Pubblico.TemiVista.Foglio(vista.Tema)" asp-append-version="true" />
        @if (vista.Documento is not null && DvCms.Web.Pubblico.TemiVista.FoglioComponenti(vista.Tema) is { } skin)
        {
            @* Skin dei componenti del tema: imposta solo token --dv-*, dopo il foglio del tema. *@
            <link rel="stylesheet" href="@skin" asp-append-version="true" />
        }
    }
    @if (vista is { NonIndicizzare: false, UrlCanonico: { } canonico })
    {
        <link rel="canonical" href="@canonico" />
        @if (vista.VociLingua.Count > 1)
        {
            @foreach (var voce in vista.VociLingua)
            {
                <link rel="alternate" hreflang="@voce.Codice" href="@voce.Url" />
            }

            @if (vista.UrlPredefinito is { } predefinito)
            {
                <link rel="alternate" hreflang="x-default" href="@predefinito" />
            }
        }
    }
    @if (vista is { EtichettaAnteprima: null, UrlCanonico: { } urlOg })
    {
        <meta property="og:type" content="website" />
        <meta property="og:title" content="@vista.TitoloDocumento" />
        <meta property="og:url" content="@urlOg" />
        <meta property="og:locale" content="@vista.CodiceLingua" />
        @if (vista.DescrizioneSeo is { } descrizioneOg)
        {
            <meta property="og:description" content="@descrizioneOg" />
        }

        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content="@vista.TitoloDocumento" />
        @if (vista.DescrizioneSeo is { } descrizioneTw)
        {
            <meta name="twitter:description" content="@descrizioneTw" />
        }
    }
    @if (vista is null || vista.EtichettaAnteprima is not null)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    else if (vista.NonIndicizzare)
    {
        <meta name="robots" content="noindex, follow" />
    }
</head>
<body class="@DvCms.Web.Pubblico.TemiVista.Classe(vista?.Tema)" style="@vista?.Tema?.VariabiliCss">
    @if (vista?.EtichettaAnteprima is { } etichetta)
    {
        <div class="anteprima" role="status">@etichetta</div>
    }
    @if (vista is null)
    {
        <main>
            <h1>@_L["Pagina non trovata"]</h1>
            <p>@_L["La pagina che cerchi non esiste o non è disponibile."]</p>
        </main>
    }
    else
    {
        @* Il tema decide l'aspetto (intestazione, selettore di lingua, contenitore, piè di pagina); il contenuto è lo stesso per ogni tema. *@
        <partial name="@DvCms.Web.Pubblico.TemiVista.Vista(vista.Tema)" model="vista" />
    }
</body>
</html>

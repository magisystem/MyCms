@model DvCms.Web.Pubblico.VistaPagina?
@{
    var vista = Model;
}
<!DOCTYPE html>
<html lang="@(vista?.CodiceLingua ?? "it")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(vista?.Titolo ?? _L["Pagina non trovata"])</title>
    <link rel="stylesheet" href="~/css/pubblico.css" />
    @if (vista is { NonIndicizzare: false, UrlCanonico: { } canonico })
    {
        <link rel="canonical" href="@canonico" />
        @if (vista.VociLingua.Count > 1)
        {
            @foreach (var voce in vista.VociLingua)
            {
                <link rel="alternate" hreflang="@voce.Codice" href="@voce.Url" />
            }

            @if (vista.UrlPredefinito is { } predefinito)
            {
                <link rel="alternate" hreflang="x-default" href="@predefinito" />
            }
        }
    }
    @if (vista is null || vista.NonIndicizzare)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
</head>
<body>
    @if (vista?.EtichettaAnteprima is { } etichetta)
    {
        <div class="anteprima" role="status">@etichetta</div>
    }
    @if (vista is { NonIndicizzare: false } && vista.VociLingua.Count > 1)
    {
        <nav class="lingue" aria-label="@_L["Lingue"]">
            @foreach (var voce in vista.VociLingua)
            {
                @if (voce.Corrente)
                {
                    <span aria-current="true" lang="@voce.Codice">@voce.Nome</span>
                }
                else
                {
                    <a href="@voce.Url" hreflang="@voce.Codice" lang="@voce.Codice">@voce.Nome</a>
                }
            }
        </nav>
    }
    <main>
        @if (vista is null)
        {
            <h1>@_L["Pagina non trovata"]</h1>
            <p>@_L["La pagina che cerchi non esiste o non è disponibile."]</p>
        }
        else
        {
            <partial name="@DvCms.Web.Pubblico.ModelliVista.Vista(vista.IdModello, vista.VersioneModello)" model="vista" />
        }
    </main>
</body>
</html>

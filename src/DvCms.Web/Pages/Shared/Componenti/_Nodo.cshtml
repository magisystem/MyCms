@using DvCms.Application.Builder
@using DvCms.Application.Cms
@model NodoCms
@inject DvCms.Application.Negozio.IServizioVetrina Vetrina
@inject DvCms.Application.Localizzazione.IContestoLingua ContestoLinguaNodo
@functions {
    private static string Valore(IReadOnlyDictionary<string, string> valori, string nome, string predefinito) =>
        valori.TryGetValue(nome, out var valore) && valore.Length > 0 ? valore : predefinito;

    // Il valore proviene da un'enumerazione già validata, ma si ricontrolla in uscita: finisce in un nome di classe.
    private static string Token(IReadOnlyDictionary<string, string> valori, string nome, string predefinito, params string[] ammessi)
    {
        var valore = Valore(valori, nome, predefinito);
        return ammessi.Contains(valore, StringComparer.Ordinal) ? valore : predefinito;
    }
}
@functions {
    private static string Animazione(IReadOnlyDictionary<string, string> stili)
    {
        var effetto = Token(stili, "animazione", "nessuna", "nessuna", "dissolvenza", "sale", "da-sinistra", "da-destra");
        if (effetto == "nessuna")
        {
            return string.Empty;
        }

        return $" dv-anim dv-anim-{effetto} dv-ritardo-{Token(stili, "ritardoAnimazione", "0", "0", "150", "300", "600")}";
    }

    private static string Allineamento(IReadOnlyDictionary<string, string> stili) =>
        "dv-allineamento-" + Token(stili, "allineamento", "sinistra", "sinistra", "centro", "destra");
}
@* Un tipo non presente nell'elenco non produce nulla: il renderer disegna solo ciò che il registro dei componenti prevede. *@
@switch (Model.Tipo)
{
    case "layout.sezione":
        <section class="dv-sezione dv-spaziatura-@Token(Model.Stili, "spaziatura", "normale", "compatta", "normale", "ampia") dv-sfondo-@Token(Model.Stili, "sfondo", "nessuno", "nessuno", "chiaro", "scuro")@Animazione(Model.Stili)">
            <div class="dv-contenitore">
                @foreach (var figlio in Model.Figli)
                {
                    <partial name="Componenti/_Nodo" model="figlio" />
                }
            </div>
        </section>
        break;
    case "layout.colonne":
        <div class="dv-colonne dv-colonne-@Math.Clamp(Model.Figli.Count, 1, 3)@Animazione(Model.Stili)">
            @foreach (var figlio in Model.Figli)
            {
                <partial name="Componenti/_Nodo" model="figlio" />
            }
        </div>
        break;
    case "layout.colonna":
        <div class="dv-colonna">
            @foreach (var figlio in Model.Figli)
            {
                <partial name="Componenti/_Nodo" model="figlio" />
            }
        </div>
        break;
    case "contenuto.titolo":
        {
            var livello = Token(Model.Proprieta, "livello", "2", "1", "2", "3");
            var classe = "dv-titolo " + Allineamento(Model.Stili) + Animazione(Model.Stili);
            var testo = Valore(Model.Proprieta, "testo", string.Empty);
            switch (livello)
            {
                case "1":
                    <h1 class="@classe">@testo</h1>
                    break;
                case "3":
                    <h3 class="@classe">@testo</h3>
                    break;
                default:
                    <h2 class="@classe">@testo</h2>
                    break;
            }
        }
        break;
    case "contenuto.testo":
        {
            var classe = "dv-testo " + Allineamento(Model.Stili) + Animazione(Model.Stili);
            foreach (var paragrafo in Valore(Model.Proprieta, "testo", string.Empty).Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                var righe = paragrafo.Split('\n', StringSplitOptions.TrimEntries);
                <p class="@classe">
                    @for (var i = 0; i < righe.Length; i++)
                    {
                        if (i > 0)
                        {
                            <br />
                        }

                        @righe[i]
                    }
                </p>
            }
        }
        break;
    case "contenuto.testo-ricco":
        {
            // Il markup si rianalizza: ciò che non rispetta la grammatica non produce nulla. Gli elementi sono fissi (p, br, strong, em, a, ul, li).
            if (TestoRicco.TentaAnalizza(Valore(Model.Proprieta, "testo", string.Empty), out var blocchi))
            {
                <div class="@("dv-testo-ricco " + Allineamento(Model.Stili) + Animazione(Model.Stili))">
                    <partial name="Componenti/_TestoRicco" model="blocchi" />
                </div>
            }
        }
        break;
    case "contenuto.immagine":
        {
            // L'identificativo è un GUID in forma canonica (ricontrollato): non può portare altro nell'indirizzo.
            var valida = Guid.TryParseExact(Valore(Model.Proprieta, "idRisorsa", string.Empty), "D", out var idRisorsa) && idRisorsa != Guid.Empty;
            var decorativa = Valore(Model.Proprieta, "decorativa", "no") == "si";
            var didascalia = Valore(Model.Proprieta, "didascalia", string.Empty);
            if (valida)
            {
                <figure class="@("dv-immagine" + Animazione(Model.Stili))">
                    <img src="/media/@idRisorsa.ToString("D")" alt="@(decorativa ? string.Empty : Valore(Model.Proprieta, "alt", string.Empty))" loading="lazy" />
                    @if (didascalia.Length > 0)
                    {
                        <figcaption>@didascalia</figcaption>
                    }
                </figure>
            }
        }
        break;
    case "contenuto.pulsante":
        {
            var url = Valore(Model.Proprieta, "url", string.Empty);
            var etichetta = Valore(Model.Proprieta, "etichetta", string.Empty);
            // Indirizzo ricontrollato anche in uscita (percorso del sito o https), come per i modelli a campi.
            if (etichetta.Length > 0 && RegistroModelliPagina.UrlConsentito(url))
            {
                <a class="pulsante dv-pulsante dv-pulsante-@Token(Model.Stili, "variante", "primario", "primario", "secondario")@Animazione(Model.Stili)" href="@url">@etichetta</a>
            }
        }
        break;
    case "contenuto.hero":
        {
            var etichetta = Valore(Model.Proprieta, "etichettaPulsante", string.Empty);
            var url = Valore(Model.Proprieta, "urlPulsante", string.Empty);
            var sottotitolo = Valore(Model.Proprieta, "sottotitolo", string.Empty);
            var haImmagine = Guid.TryParseExact(Valore(Model.Proprieta, "idRisorsa", string.Empty), "D", out var idSfondo) && idSfondo != Guid.Empty;
            <section class="dv-hero dv-altezza-@Token(Model.Stili, "altezza", "normale", "compatta", "normale", "alta") dv-sfondo-@Token(Model.Stili, "sfondo", "scuro", "chiaro", "scuro") @Allineamento(Model.Stili)@Animazione(Model.Stili)">
                @if (haImmagine)
                {
                    <img class="dv-hero-immagine" src="/media/@idSfondo.ToString("D")" alt="" loading="lazy" />
                }
                <div class="dv-contenitore dv-hero-contenuto">
                    <h1 class="dv-hero-titolo">@Valore(Model.Proprieta, "titolo", string.Empty)</h1>
                    @if (sottotitolo.Length > 0)
                    {
                        <p class="dv-hero-sottotitolo">@sottotitolo</p>
                    }
                    @if (etichetta.Length > 0 && RegistroModelliPagina.UrlConsentito(url))
                    {
                        <a class="pulsante dv-pulsante dv-pulsante-primario" href="@url">@etichetta</a>
                    }
                </div>
            </section>
        }
        break;
    case "contenuto.cta":
        {
            var url = Valore(Model.Proprieta, "url", string.Empty);
            var etichetta = Valore(Model.Proprieta, "etichetta", string.Empty);
            var testo = Valore(Model.Proprieta, "testo", string.Empty);
            <section class="dv-cta dv-sfondo-@Token(Model.Stili, "sfondo", "chiaro", "chiaro", "scuro", "primario") @Allineamento(Model.Stili)@Animazione(Model.Stili)">
                <div class="dv-contenitore">
                    <h2 class="dv-cta-titolo">@Valore(Model.Proprieta, "titolo", string.Empty)</h2>
                    @if (testo.Length > 0)
                    {
                        <p>@testo</p>
                    }
                    @if (etichetta.Length > 0 && RegistroModelliPagina.UrlConsentito(url))
                    {
                        <a class="pulsante dv-pulsante dv-pulsante-primario" href="@url">@etichetta</a>
                    }
                </div>
            </section>
        }
        break;
    case "contenuto.fisarmonica":
        <div class="@("dv-fisarmonica" + Animazione(Model.Stili))">
            @foreach (var figlio in Model.Figli)
            {
                <partial name="Componenti/_Nodo" model="figlio" />
            }
        </div>
        break;
    case "contenuto.voce":
        {
            // Pannelli apribili con <details>: nessuno script, accessibili da tastiera per costruzione.
            <details class="dv-voce">
                <summary>@Valore(Model.Proprieta, "domanda", string.Empty)</summary>
                <div class="dv-voce-risposta">
                    @foreach (var paragrafo in Valore(Model.Proprieta, "risposta", string.Empty).Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <p>@paragrafo</p>
                    }
                </div>
            </details>
        }
        break;
    case "contenuto.caratteristiche":
        <div class="@("dv-caratteristiche dv-colonne dv-colonne-" + Token(Model.Stili, "colonne", "3", "2", "3") + Animazione(Model.Stili))">
            @foreach (var figlio in Model.Figli)
            {
                <partial name="Componenti/_Nodo" model="figlio" />
            }
        </div>
        break;
    case "contenuto.caratteristica":
        {
            var descrizione = Valore(Model.Proprieta, "descrizione", string.Empty);
            <div class="dv-caratteristica">
                <h3 class="dv-caratteristica-titolo">@Valore(Model.Proprieta, "titolo", string.Empty)</h3>
                @if (descrizione.Length > 0)
                {
                    <p>@descrizione</p>
                }
            </div>
        }
        break;
    case "contenuto.testimonianze":
        <div class="@("dv-testimonianze" + Animazione(Model.Stili))">
            @foreach (var figlio in Model.Figli)
            {
                <partial name="Componenti/_Nodo" model="figlio" />
            }
        </div>
        break;
    case "contenuto.testimonianza":
        {
            var ruolo = Valore(Model.Proprieta, "ruolo", string.Empty);
            <figure class="dv-testimonianza">
                <blockquote class="dv-testimonianza-citazione">
                    @foreach (var paragrafo in Valore(Model.Proprieta, "citazione", string.Empty).Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <p>@paragrafo</p>
                    }
                </blockquote>
                <figcaption class="dv-testimonianza-autore">
                    <strong>@Valore(Model.Proprieta, "autore", string.Empty)</strong>@(ruolo.Length > 0 ? ", " + ruolo : string.Empty)
                </figcaption>
            </figure>
        }
        break;
    case "negozio.griglia-prodotti":
        {
            // Legge i prodotti pubblicati al momento della visita (il documento non copia il catalogo): se il negozio non è attivo
            // o non c'è nulla da mostrare il componente non produce niente.
            var quanti = int.Parse(Token(Model.Proprieta, "quanti", "6", "3", "6", "9", "12"), System.Globalization.CultureInfo.InvariantCulture);
            var prodotti = (await Vetrina.ElencaAsync(ContestoLinguaNodo.CodiceLingua, Context.RequestAborted)).Take(quanti).ToList();
            if (prodotti.Count > 0)
            {
                var cultura = System.Globalization.CultureInfo.GetCultureInfo("it-IT");
                <ul class="@("dv-griglia-prodotti dv-griglia-prodotti-colonne-" + Token(Model.Stili, "colonne", "3", "2", "3") + Animazione(Model.Stili))">
                    @foreach (var prodotto in prodotti)
                    {
                        <li class="dv-griglia-prodotto@(prodotto.Disponibile ? string.Empty : " dv-esaurito")">
                            @if (prodotto.Immagine is { } immagine)
                            {
                                <a href="/negozio/@prodotto.Id.ToString("D")" tabindex="-1" aria-hidden="true"><img class="dv-griglia-prodotto-immagine" src="/media/@immagine.Id.ToString("D")" alt="" loading="lazy" /></a>
                            }
                            <a href="/negozio/@prodotto.Id.ToString("D")">@(prodotto.Nome.Length > 0 ? prodotto.Nome : "—")</a>
                            <p>@_L["da"] @prodotto.PrezzoDa.ToString("N2", cultura) @prodotto.Valuta</p>
                            @if (!prodotto.Disponibile)
                            {
                                <p>@_L["Esaurito"]</p>
                            }
                        </li>
                    }
                </ul>
            }
        }
        break;
    case "negozio.scheda-prodotto":
        {
            // Il documento conserva solo l'identificativo: nome, descrizione, prezzi e disponibilità si leggono alla visita, e un prodotto
            // non più pubblicato (o di un negozio spento) non produce nulla.
            var scelto = Guid.TryParseExact(Valore(Model.Proprieta, "idProdotto", string.Empty), "D", out var idProdotto)
                ? await Vetrina.LeggiAsync(idProdotto, ContestoLinguaNodo.CodiceLingua, Context.RequestAborted)
                : null;
            if (scelto is not null)
            {
                var cultura = System.Globalization.CultureInfo.GetCultureInfo("it-IT");
                var disponibile = scelto.Varianti.Any(v => v.Massimo > 0);
                <article class="@("dv-scheda-prodotto" + Animazione(Model.Stili))">
                    @if (scelto.Immagini?.FirstOrDefault() is { } principale)
                    {
                        <img class="dv-scheda-prodotto-immagine" src="/media/@principale.Id.ToString("D")" alt="@(principale.Testo is { Length: > 0 } testo ? testo : scelto.Nome)" loading="lazy" />
                    }
                    <h3 class="dv-scheda-prodotto-nome">@(scelto.Nome.Length > 0 ? scelto.Nome : "—")</h3>
                    @foreach (var paragrafo in scelto.Descrizione.Split("\n\n", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                    {
                        <p>@paragrafo</p>
                    }
                    <ul class="dv-scheda-prodotto-varianti">
                        @foreach (var variante in scelto.Varianti)
                        {
                            <li>@(variante.Etichetta is { Length: > 0 } etichetta ? etichetta + ": " : string.Empty)@variante.PrezzoLordo.ToString("N2", cultura) @variante.Valuta@(variante.Massimo > 0 ? string.Empty : " — " + _L["Esaurito"])</li>
                        }
                    </ul>
                    <p><a class="pulsante dv-pulsante dv-pulsante-primario" href="/negozio/@scelto.Id.ToString("D")">@(disponibile ? _L["Vedi e acquista"] : _L["Vedi il prodotto"])</a></p>
                </article>
            }
        }
        break;
}

@inject DvCms.Application.Negozio.IServizioCatalogo Catalogo
<ul class="navbar-nav pt-lg-3">
    <li class="nav-section-title">@_L["Generale"]</li>
    <li class="nav-item">
        <a class="nav-link" href="/admin">
            <span class="nav-link-icon"><i class="ti ti-home"></i></span>
            <span class="nav-link-title">@_L["Cruscotto"]</span>
        </a>
    </li>
    <li class="nav-section-title">@_L["Contenuti"]</li>
    <li class="nav-item">
        <a class="nav-link" href="/admin/pagine">
            <span class="nav-link-icon"><i class="ti ti-file-text"></i></span>
            <span class="nav-link-title">@_L["Pagine"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/admin/media">
            <span class="nav-link-icon"><i class="ti ti-photo"></i></span>
            <span class="nav-link-title">@_L["Media"]</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" href="/admin/tema">
            <span class="nav-link-icon"><i class="ti ti-palette"></i></span>
            <span class="nav-link-title">@_L["Aspetto"]</span>
        </a>
    </li>
    @* Il negozio compare solo nei siti che lo hanno attivo; le pagine verificano comunque lo stesso requisito lato server. *@
    @if (await Catalogo.CommercioAttivoAsync(Context.RequestAborted))
    {
        <li class="nav-section-title">@_L["Negozio"]</li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/negozio/prodotti">
                <span class="nav-link-icon"><i class="ti ti-shopping-cart"></i></span>
                <span class="nav-link-title">@_L["Prodotti"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/negozio/spedizioni">
                <span class="nav-link-icon"><i class="ti ti-truck-delivery"></i></span>
                <span class="nav-link-title">@_L["Spedizioni"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/negozio/giacenze">
                <span class="nav-link-icon"><i class="ti ti-packages"></i></span>
                <span class="nav-link-title">@_L["Giacenze"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/negozio/ordini">
                <span class="nav-link-icon"><i class="ti ti-receipt"></i></span>
                <span class="nav-link-title">@_L["Ordini"]</span>
            </a>
        </li>
    }
    @* La visibilità è solo comodità: ogni pagina dell'area Platform è protetta lato server dalla politica del PlatformAdmin. *@
    @if (User.IsInRole("PlatformAdmin"))
    {
        <li class="nav-section-title">@_L["Platform"]</li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/platform/tenant">
                <span class="nav-link-icon"><i class="ti ti-building"></i></span>
                <span class="nav-link-title">@_L["Tenant"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/platform/coda">
                <span class="nav-link-icon"><i class="ti ti-list-check"></i></span>
                <span class="nav-link-title">@_L["Coda"]</span>
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="/admin/platform/testi">
                <span class="nav-link-icon"><i class="ti ti-language"></i></span>
                <span class="nav-link-title">@_L["Testi"]</span>
            </a>
        </li>
    }
</ul>

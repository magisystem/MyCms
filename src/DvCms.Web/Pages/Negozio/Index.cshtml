@page "/negozio"
@model DvCms.Web.Pages.Negozio.IndexModel
@{
    ViewData["Titolo"] = _L["Negozio"];
}
<h1>@_L["Negozio"]</h1>
@if (Model.Categorie.Count > 0)
{
    <nav class="dv-categorie" aria-label="@_L["Categorie"]">
        <a href="/negozio" aria-current="@(Model.Selezionata is null ? "true" : null)">@_L["Tutti"]</a>
        @foreach (var categoria in Model.Categorie)
        {
            <a href="/negozio?categoria=@categoria.Id" aria-current="@(Model.Selezionata?.Id == categoria.Id ? "true" : null)">@(categoria.Nome.Length > 0 ? categoria.Nome : "—") (@categoria.Prodotti)</a>
        }
    </nav>
}
@if (Model.Prodotti.Count == 0)
{
    <p>@_L["Nessun prodotto disponibile."]</p>
}
else
{
    <ul class="dv-prodotti">
        @foreach (var prodotto in Model.Prodotti)
        {
            <li class="dv-prodotto @(prodotto.Disponibile ? null : "dv-esaurito")">
                @if (prodotto.Immagine is { } immagine)
                {
                    <a href="/negozio/@prodotto.Id" tabindex="-1" aria-hidden="true"><img class="dv-prodotto-immagine" src="/media/@immagine.Id" alt="" loading="lazy" /></a>
                }
                <a href="/negozio/@prodotto.Id">@(prodotto.Nome.Length > 0 ? prodotto.Nome : "—")</a>
                <p class="dv-prodotto-prezzo">@_L["da"] @prodotto.PrezzoDa.ToString("N2", Model.Cultura) @prodotto.Valuta</p>
                @if (!prodotto.Disponibile)
                {
                    <p>@_L["Esaurito"]</p>
                }
            </li>
        }
    </ul>
}

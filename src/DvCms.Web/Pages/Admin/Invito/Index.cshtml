@page "/admin/invito"
@model DvCms.Web.Pages.Admin.Invito.IndexModel
@{
    Layout = "_LayoutAccesso";
    ViewData["Titolo"] = _L["Scegli la tua password"];
}
<div class="card card-md">
    <div class="card-body">
        @if (Model.Completato)
        {
            <h2 class="h2 text-center mb-2">@_L["Account attivato"]</h2>
            <p class="text-secondary text-center mb-3">@_L["Ora puoi accedere con la password che hai scelto."]</p>
            <a href="/admin/accesso" class="btn btn-primary w-100">@_L["Vai all'accesso"]</a>
        }
        else if (!Model.LinkValido)
        {
            <h2 class="h2 text-center mb-2">@_L["Invito non valido"]</h2>
            <p class="text-secondary text-center mb-3">@_L["Il link è scaduto, è già stato usato oppure non è corretto. Chiedi all'amministratore della piattaforma di inviartene uno nuovo."]</p>
        }
        else
        {
            <h2 class="h2 text-center mb-4">@_L["Scegli la tua password"]</h2>
            @if (Model.Messaggio is not null)
            {
                <div class="alert alert-danger" role="alert">@Model.Messaggio</div>
            }
            <form method="post" autocomplete="off" novalidate>
                <input type="hidden" name="Token" value="@Model.Token" />
                <div class="mb-3">
                    <label class="form-label" for="NuovaPassword">@_L["Password"]</label>
                    <input type="password" class="form-control" id="NuovaPassword" name="NuovaPassword" autocomplete="new-password" required />
                    <div class="form-hint">@_L["Da 12 a 128 caratteri."]</div>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ConfermaPassword">@_L["Conferma la password"]</label>
                    <input type="password" class="form-control" id="ConfermaPassword" name="ConfermaPassword" autocomplete="new-password" required />
                </div>
                <div class="form-footer">
                    <button type="submit" class="btn btn-primary w-100">@_L["Attiva l'account"]</button>
                </div>
            </form>
        }
    </div>
</div>

@page "/admin/pagine/nuova"
@model DvCms.Web.Pages.Admin.Pagine.NuovaModel
@{
    ViewData["Titolo"] = _L["Nuova pagina"];
}
<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card">
            <div class="card-body">
                @if (Model.Errore is not null)
                {
                    <div class="alert alert-danger" role="alert">@Model.Errore</div>
                }
                @if (Model.TitoloOrigine is not null)
                {
                    <div class="alert alert-info" role="status">@_L["Traduzione di"]: <strong>@Model.TitoloOrigine</strong></div>
                }
                <form method="get" class="row g-2 align-items-end mb-4">
                    @if (Model.TraduzioneDi is { } origine)
                    {
                        <input type="hidden" name="traduzioneDi" value="@origine" />
                    }
                    <div class="col">
                        <label class="form-label" for="modello">@_L["Modello di pagina"]</label>
                        <select class="form-select" id="modello" name="modello" data-auto-invio>
                            @foreach (var modello in Model.Modelli)
                            {
                                <option value="@modello.Id" selected="@(modello.Id == Model.Modello.Id)">@DvCms.Web.Cms.EtichetteModelli.NomeModello(_L, modello.Id)</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto"><button type="submit" class="btn">@_L["Usa questo modello"]</button></div>
                </form>
                <form method="post" asp-route-modello="@Model.Modello.Id" asp-route-traduzioneDi="@Model.TraduzioneDi" novalidate>
                    <div class="mb-3">
                        <label class="form-label" for="Titolo">@_L["Titolo"]</label>
                        <input class="form-control" id="Titolo" name="Titolo" value="@Model.Titolo" maxlength="200" required />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="Slug">@_L["Indirizzo (slug)"]</label>
                            <input class="form-control" id="Slug" name="Slug" value="@Model.Slug" maxlength="100" />
                            <div class="form-hint">@_L["Lettere minuscole, cifre e trattini. Se vuoto si ricava dal titolo."]</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="CodiceLingua">@_L["Lingua"]</label>
                            <select class="form-select" id="CodiceLingua" name="CodiceLingua">
                                @foreach (var lingua in Model.Lingue)
                                {
                                    <option value="@lingua.Codice" selected="@(lingua.Codice == Model.CodiceLingua)">@lingua.Nome</option>
                                }
                            </select>
                        </div>
                    </div>
                    @foreach (var campo in Model.Modello.Campi)
                    {
                        <div class="mb-3">
                            <label class="form-label @(campo.Obbligatorio ? "required" : null)" for="m_@campo.Nome">@DvCms.Web.Cms.EtichetteModelli.Campo(_L, campo.Nome)</label>
                            @if (campo.Tipo == DvCms.Application.Cms.TipoCampoModello.TestoLungo)
                            {
                                <textarea class="form-control @(Model.CampiNonValidi.Contains(campo.Nome) ? "is-invalid" : null)" id="m_@campo.Nome" name="m_@campo.Nome" rows="3" maxlength="@campo.LunghezzaMassima">@Model.Valori.GetValueOrDefault(campo.Nome)</textarea>
                            }
                            else
                            {
                                <input class="form-control @(Model.CampiNonValidi.Contains(campo.Nome) ? "is-invalid" : null)" id="m_@campo.Nome" name="m_@campo.Nome" value="@Model.Valori.GetValueOrDefault(campo.Nome)" maxlength="@campo.LunghezzaMassima"
                                       placeholder="@(campo.Tipo == DvCms.Application.Cms.TipoCampoModello.Url ? "/pagina oppure https://..." : null)" />
                            }
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="Contenuto">@_L["Contenuto"]</label>
                        <textarea class="form-control" id="Contenuto" name="Contenuto" rows="12" maxlength="100000">@Model.Contenuto</textarea>
                        <div class="form-hint">@_L["Testo semplice: separa i paragrafi con una riga vuota."]</div>
                    </div>
                    <fieldset class="mb-3">
                        <legend class="form-label">@_L["Motori di ricerca"]</legend>
                        <div class="mb-3">
                            <label class="form-label" for="TitoloSeo">@_L["Titolo per i motori di ricerca"]</label>
                            <input class="form-control @(Model.CampiNonValidi.Contains("TitoloSeo") ? "is-invalid" : null)" id="TitoloSeo" name="TitoloSeo" value="@Model.TitoloSeo" maxlength="200" />
                            <div class="form-hint">@_L["Se vuoto si usa il titolo della pagina."]</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="DescrizioneSeo">@_L["Descrizione per i motori di ricerca"]</label>
                            <textarea class="form-control @(Model.CampiNonValidi.Contains("DescrizioneSeo") ? "is-invalid" : null)" id="DescrizioneSeo" name="DescrizioneSeo" rows="2" maxlength="500">@Model.DescrizioneSeo</textarea>
                        </div>
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="NonIndicizzare" value="true" @(Model.NonIndicizzare ? "checked" : null) />
                            <span class="form-check-label">@_L["Non indicizzare questa pagina"]</span>
                        </label>
                    </fieldset>
                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="PaginaIniziale" value="true" @(Model.PaginaIniziale ? "checked" : null) />
                            <span class="form-check-label">@_L["Pagina iniziale del sito"]</span>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">@_L["Crea la bozza"]</button>
                    <a href="/admin/pagine" class="btn btn-link">@_L["Annulla"]</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Script {
    <script src="~/js/auto-invio.js"></script>
}

@page "/admin/pagine/{id:guid}"
@model DvCms.Web.Pages.Admin.Pagine.ModificaModel
@using DvCms.Domain.Cms
@{
    var pagina = Model.Pagina!;
    ViewData["Titolo"] = _L["Modifica pagina"];
}
@if (Model.Messaggio is not null)
{
    <div class="alert alert-success" role="status">@Model.Messaggio</div>
}
@if (Model.ErroreDaMostrare is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErroreDaMostrare</div>
}
<div class="row row-cards">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    /@pagina.Slug
                    @if (pagina.Stato == StatoPagina.Pubblicata)
                    {
                        <span class="badge bg-green-lt ms-2">@_L["Pubblicata"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-lt ms-2">@_L["Bozza"]</span>
                    }
                    @if (pagina.ModificheNonPubblicate && pagina.Stato == StatoPagina.Pubblicata)
                    {
                        <span class="badge bg-orange-lt ms-1">@_L["Modifiche non pubblicate"]</span>
                    }
                </h3>
                <div class="card-actions"><a href="/admin/pagine" class="btn btn-link">@_L["Torna all'elenco"]</a></div>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Salva" asp-route-id="@pagina.Id" novalidate>
                    <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                    <div class="mb-3">
                        <label class="form-label" for="Titolo">@_L["Titolo"]</label>
                        <input class="form-control" id="Titolo" name="Titolo" value="@pagina.Titolo" maxlength="200" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="Slug">@_L["Indirizzo (slug)"]</label>
                        <input class="form-control" id="Slug" name="Slug" value="@pagina.Slug" maxlength="100" />
                        @if (pagina.Stato == StatoPagina.Pubblicata)
                        {
                            <div class="form-hint">@_L["Se cambi l'indirizzo di una pagina pubblicata, il vecchio indirizzo reindirizza al nuovo."]</div>
                        }
                    </div>
                    <p class="text-secondary small mb-3">
                        @_L["Modello"]: <strong>@DvCms.Web.Cms.EtichetteModelli.NomeModello(_L, pagina.IdModello)</strong> (v@(pagina.VersioneModello))
                    </p>
                    @foreach (var campo in Model.Modello?.Campi ?? [])
                    {
                        <div class="mb-3">
                            <label class="form-label @(campo.Obbligatorio ? "required" : null)" for="m_@campo.Nome">@DvCms.Web.Cms.EtichetteModelli.Campo(_L, campo.Nome)</label>
                            @if (campo.Tipo == DvCms.Application.Cms.TipoCampoModello.TestoLungo)
                            {
                                <textarea class="form-control @(Model.CampiNonValidi.Contains(campo.Nome) ? "is-invalid" : null)" id="m_@campo.Nome" name="m_@campo.Nome" rows="3" maxlength="@campo.LunghezzaMassima">@pagina.DatiModello.GetValueOrDefault(campo.Nome)</textarea>
                            }
                            else
                            {
                                <input class="form-control @(Model.CampiNonValidi.Contains(campo.Nome) ? "is-invalid" : null)" id="m_@campo.Nome" name="m_@campo.Nome" value="@pagina.DatiModello.GetValueOrDefault(campo.Nome)" maxlength="@campo.LunghezzaMassima"
                                       placeholder="@(campo.Tipo == DvCms.Application.Cms.TipoCampoModello.Url ? "/pagina oppure https://..." : null)" />
                            }
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="Contenuto">@_L["Contenuto"]</label>
                        <textarea class="form-control" id="Contenuto" name="Contenuto" rows="14" maxlength="100000">@pagina.Contenuto</textarea>
                        <div class="form-hint">@_L["Testo semplice: separa i paragrafi con una riga vuota."]</div>
                    </div>
                    <fieldset class="mb-3">
                        <legend class="form-label">@_L["Motori di ricerca"]</legend>
                        <div class="mb-3">
                            <label class="form-label" for="TitoloSeo">@_L["Titolo per i motori di ricerca"]</label>
                            <input class="form-control @(Model.CampiNonValidi.Contains("TitoloSeo") ? "is-invalid" : null)" id="TitoloSeo" name="TitoloSeo" value="@pagina.TitoloSeo" maxlength="200" />
                            <div class="form-hint">@_L["Se vuoto si usa il titolo della pagina."]</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="DescrizioneSeo">@_L["Descrizione per i motori di ricerca"]</label>
                            <textarea class="form-control @(Model.CampiNonValidi.Contains("DescrizioneSeo") ? "is-invalid" : null)" id="DescrizioneSeo" name="DescrizioneSeo" rows="2" maxlength="500">@pagina.DescrizioneSeo</textarea>
                        </div>
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="NonIndicizzare" value="true" @(pagina.NonIndicizzare ? "checked" : null) />
                            <span class="form-check-label">@_L["Non indicizzare questa pagina"]</span>
                        </label>
                    </fieldset>
                    <div class="mb-3">
                        <label class="form-label" for="Nota">@_L["Nota sulla modifica"]</label>
                        <input class="form-control" id="Nota" name="Nota" maxlength="500" />
                    </div>
                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="PaginaIniziale" value="true" @(pagina.PaginaIniziale ? "checked" : null) />
                            <span class="form-check-label">@_L["Pagina iniziale del sito"]</span>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary">@_L["Salva la bozza"]</button>
                </form>
            </div>
            <div class="card-footer">
                <a href="/admin/pagine/@pagina.Id/anteprima" class="btn" target="_blank" rel="noopener">@_L["Anteprima della bozza"]</a>
                <form method="post" asp-page-handler="Pubblica" asp-route-id="@pagina.Id" class="d-inline">
                    <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                    <button type="submit" class="btn btn-success" disabled="@(!pagina.ModificheNonPubblicate && pagina.Stato == StatoPagina.Pubblicata)">@_L["Pubblica l'ultima bozza"]</button>
                </form>
                @if (pagina.VersioneModelloRecente is { } recente)
                {
                    <form method="post" asp-page-handler="AggiornaModello" asp-route-id="@pagina.Id" class="d-inline">
                        <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                        <button type="submit" class="btn btn-outline-primary">@_L["Passa all'ultima versione del modello"] (v@(recente))</button>
                    </form>
                }
                @if (pagina.Stato == StatoPagina.Pubblicata)
                {
                    <form method="post" asp-page-handler="Ritira" asp-route-id="@pagina.Id" class="d-inline">
                        <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                        <button type="submit" class="btn btn-outline-danger">@_L["Ritira dal pubblico"]</button>
                    </form>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header"><h3 class="card-title">@_L["Lingue"]</h3></div>
            <div class="list-group list-group-flush">
                <div class="list-group-item"><strong>@pagina.CodiceLingua</strong> <span class="text-secondary">/@pagina.Slug</span> <span class="badge bg-blue-lt ms-1">@_L["questa pagina"]</span></div>
                @foreach (var traduzione in pagina.Traduzioni)
                {
                    <a class="list-group-item list-group-item-action" href="/admin/pagine/@traduzione.IdPagina">
                        <strong>@traduzione.CodiceLingua</strong> <span class="text-secondary">/@traduzione.Slug</span>
                        <span class="badge @(traduzione.Stato == StatoPagina.Pubblicata ? "bg-green-lt" : "bg-secondary-lt") ms-1">@(traduzione.Stato == StatoPagina.Pubblicata ? _L["Pubblicata"] : _L["Bozza"])</span>
                    </a>
                }
                @if (pagina.LingueMancanti.Count > 0)
                {
                    <div class="list-group-item">
                        <a href="/admin/pagine/nuova?traduzioneDi=@pagina.Id" class="btn btn-sm">@_L["Aggiungi una traduzione"] (@string.Join(", ", pagina.LingueMancanti.Select(l => l.Codice)))</a>
                    </div>
                }
            </div>
        </div>
        @if (pagina.Reindirizzamenti is { Count: > 0 } reindirizzamenti)
        {
            <div class="card mb-3">
                <div class="card-header"><h3 class="card-title">@_L["Reindirizzamenti"]</h3></div>
                <div class="list-group list-group-flush">
                    @foreach (var reindirizzamento in reindirizzamenti)
                    {
                        <div class="list-group-item d-flex align-items-center justify-content-between">
                            <span><code>/@reindirizzamento.SlugOrigine</code> &rarr; <code>/@pagina.Slug</code></span>
                            <form method="post" asp-page-handler="EliminaReindirizzamento" asp-route-id="@pagina.Id" asp-route-idReindirizzamento="@reindirizzamento.Id" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@_L["Elimina"]</button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
        <div class="card">
            <div class="card-header"><h3 class="card-title">@_L["Revisioni"]</h3></div>
            <div class="list-group list-group-flush">
                @foreach (var revisione in pagina.Revisioni)
                {
                    <div class="list-group-item">
                        <div>
                            #@revisione.Numero - @revisione.Titolo
                            @if (revisione.Pubblicata)
                            {
                                <span class="badge bg-green-lt ms-1">@_L["Pubblicata"]</span>
                            }
                            @if (revisione.UltimaBozza)
                            {
                                <span class="badge bg-blue-lt ms-1">@_L["Ultima bozza"]</span>
                            }
                        </div>
                        <div class="text-secondary small">
                            @revisione.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC
                            @if (revisione.AutoreDiPiattaforma)
                            {
                                <span>- @_L["Amministratore della piattaforma"]</span>
                            }
                            else if (revisione.Autore is not null)
                            {
                                <span>- @revisione.Autore</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(revisione.Nota))
                        {
                            <div class="small">@revisione.Nota</div>
                        }
                        <div class="mt-2 d-flex flex-wrap gap-1">
                            <a href="/admin/pagine/@pagina.Id/anteprima?revisione=@revisione.Id" class="btn btn-sm" target="_blank" rel="noopener">@_L["Anteprima"]</a>
                            @if (!revisione.Pubblicata)
                            {
                                <form method="post" asp-page-handler="PubblicaRevisione" asp-route-id="@pagina.Id" class="d-inline">
                                    <input type="hidden" name="idRevisione" value="@revisione.Id" />
                                    <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                                    <button type="submit" class="btn btn-sm">@_L["Pubblica questa"]</button>
                                </form>
                            }
                            @if (!revisione.UltimaBozza)
                            {
                                <form method="post" asp-page-handler="Ripristina" asp-route-id="@pagina.Id" class="d-inline">
                                    <input type="hidden" name="idRevisione" value="@revisione.Id" />
                                    <input type="hidden" name="TokenConcorrenza" value="@pagina.TokenConcorrenza" />
                                    <button type="submit" class="btn btn-sm">@_L["Ripristina come bozza"]</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@page "/admin/negozio/ordini"
@model DvCms.Web.Pages.Admin.Negozio.Ordini.IndexModel
@{
    ViewData["Titolo"] = _L["Ordini"];
}
@if (Model.Messaggio is not null)
{
    <div class="alert alert-success" role="status">@Model.Messaggio</div>
}
@if (Model.ErroreDaMostrare is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErroreDaMostrare</div>
}
<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">@_L["Esporta gli ordini in CSV"]</h3></div>
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="handler" value="Esporta" />
            <div class="col-md-2">
                <label class="form-label" for="dal">@_L["Dal"]</label>
                <input type="date" class="form-control" id="dal" name="dal" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="al">@_L["Al"]</label>
                <input type="date" class="form-control" id="al" name="al" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="stato">@_L["Stato"]</label>
                <select class="form-select" id="stato" name="stato">
                    <option value="">@_L["Tutti"]</option>
                    @foreach (var stato in DvCms.Web.Pages.Admin.Negozio.Ordini.IndexModel.StatiFiltrabili)
                    {
                        <option value="@stato">@Model.Stato(stato)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="formato">@_L["Formato"]</label>
                <select class="form-select" id="formato" name="formato">
                    <option value="Ordini">@_L["Una riga per ordine"]</option>
                    <option value="Righe">@_L["Una riga per articolo (contabilità)"]</option>
                </select>
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">@_L["Scarica"]</button></div>
        </form>
        <div class="form-hint mt-2">@_L["Il file contiene dati personali degli acquirenti: conservalo e condividilo con cautela. Le date sono UTC; i decimali usano la virgola."]</div>
    </div>
</div>
<div class="card">
    @if (Model.Ordini.Count == 0)
    {
        <div class="card-body text-secondary">@_L["Nessun ordine."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>@_L["Ordine"]</th>
                        <th>@_L["Data"]</th>
                        <th>@_L["Cliente"]</th>
                        <th>@_L["Stato"]</th>
                        <th>@_L["Totale"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ordine in Model.Ordini)
                    {
                        <tr>
                            <td><a href="/admin/negozio/ordini/@ordine.Id">#@ordine.Numero</a></td>
                            <td class="text-secondary">@ordine.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@ordine.EmailAcquirente</td>
                            <td><span class="badge bg-secondary-lt">@Model.Stato(ordine.Stato)</span></td>
                            <td>@ordine.TotaleLordo.ToString("N2", Model.Cultura) @ordine.Valuta</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

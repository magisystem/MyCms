@page "/admin/negozio/ordini/{id:guid}"
@model DvCms.Web.Pages.Admin.Negozio.Ordini.DettaglioModel
@using DvCms.Domain.Negozio
@{
    var o = Model.Ordine;
    ViewData["Titolo"] = _L["Ordine"] + " #" + o.Numero;
    string Importo(decimal valore) => $"{valore.ToString("N2", Model.Cultura)} {o.Valuta}";
}
@if (Model.Messaggio is not null)
{
    <div class="alert alert-success" role="status">@Model.Messaggio</div>
}
@if (Model.ErroreDaMostrare is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErroreDaMostrare</div>
}
@if (Model.DaRimborsare)
{
    <div class="alert alert-warning" role="alert">@_L["Il provider ha incassato questo ordine ma l'ordine non si può completare: rimborsa l'incasso qui sotto."]</div>
}
<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr><th>@_L["Articolo"]</th><th>@_L["Prezzo"]</th><th>@_L["Quantità"]</th><th>IVA</th><th>@_L["Totale"]</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var riga in o.Righe)
                        {
                            <tr>
                                <td>@riga.NomeProdotto@(riga.EtichettaVariante is { Length: > 0 } etichetta ? " — " + etichetta : null) <small class="text-secondary">(@riga.Sku)</small></td>
                                <td>@Importo(riga.PrezzoUnitarioLordo)</td>
                                <td>@riga.Quantita</td>
                                <td>@riga.AliquotaIva.ToString("0.##", Model.Cultura)%</td>
                                <td>@Importo(riga.Lordo)</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="3">@o.NomeSpedizione</td>
                            <td>22%</td>
                            <td>@Importo(o.SpedizioneLorda)</td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr><td colspan="4">@_L["Imponibile"]</td><td>@Importo(o.TotaleImponibile)</td></tr>
                        <tr><td colspan="4">IVA</td><td>@Importo(o.TotaleIva)</td></tr>
                        <tr><td colspan="4"><strong>@_L["Totale (IVA inclusa)"]</strong></td><td><strong>@Importo(o.TotaleLordo)</strong></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <p><strong>@_L["Stato"]</strong><br />@Model.Stato(o.Stato)</p>
                <p><strong>@_L["Cliente"]</strong><br />@o.NomeAcquirente<br />@o.EmailAcquirente</p>
                <details>
                    <summary class="text-secondary">@_L["Dati personali dell'acquirente"]</summary>
                    <form method="post" asp-page-handler="AnonimizzaAcquirente" asp-route-id="@o.Id">
                        <p class="text-secondary small">@_L["Email, nome, password e carrello dell'account si cancellano e gli ordini non pagati si annullano; gli ordini pagati restano. Non si può annullare."]</p>
                        <label class="form-check"><input type="checkbox" class="form-check-input" required /> <span class="form-check-label">@_L["Confermo la richiesta dell'interessato"]</span></label>
                        <button type="submit" class="btn btn-outline-danger btn-sm">@_L["Anonimizza l'account dell'acquirente"]</button>
                    </form>
                </details>
                <p><strong>@_L["Data"]</strong><br />@o.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
                @if (o.TipoSpedizione == TipoMetodoSpedizione.Ritiro)
                {
                    <p><strong>@_L["Consegna"]</strong><br />@_L["Ritiro in sede."]</p>
                }
                else
                {
                    <address>
                        <strong>@_L["Consegna"]</strong><br />
                        @o.Destinatario<br />
                        @o.IndirizzoRiga1<br />
                        @if (!string.IsNullOrEmpty(o.IndirizzoRiga2))
                        {
                            @o.IndirizzoRiga2<br />
                        }
                        @o.Cap @o.Citta (@o.Paese)
                    </address>
                }
            </div>
        </div>
        @if (o.Stato == StatoOrdine.Pagato)
        {
            <form method="post" asp-page-handler="Evaso" asp-route-id="@o.Id" class="mt-3">
                <button type="submit" class="btn btn-primary">@(o.TipoSpedizione == TipoMetodoSpedizione.Ritiro ? _L["Segna come ritirato"] : _L["Segna come spedito"])</button>
            </form>
        }
        @if (Model.Tentativi.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">@_L["Pagamenti"]</h3></div>
                <ul class="list-group list-group-flush">
                    @foreach (var tentativo in Model.Tentativi)
                    {
                        <li class="list-group-item">
                            @Model.StatoTentativo(tentativo.Stato)<br />
                            <small class="text-secondary">@tentativo.IdProvider · @tentativo.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm")</small>
                            @if (tentativo.Stato == StatoTentativoPagamento.DaRimborsare)
                            {
                                <form method="post" asp-page-handler="RimborsaIncasso" asp-route-id="@o.Id" class="mt-2">
                                    <input type="hidden" name="idTentativo" value="@tentativo.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">@_L["Rimborsa l'incasso"] (@Importo(tentativo.Importo))</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        @if (Model.PuoRimborsare)
        {
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">@_L["Rimborso"]</h3></div>
                <div class="card-body">
                    <p class="text-secondary">@_L["Rimborsato"]: @Importo(o.TotaleRimborsato) — @_L["ancora rimborsabile"]: @Importo(Model.Residuo)</p>
                    <form method="post" asp-page-handler="Rimborsa" asp-route-id="@o.Id">
                        <div class="mb-2">
                            <label class="form-label" for="importo">@_L["Importo (vuoto = tutto ciò che resta)"]</label>
                            <input class="form-control" id="importo" name="importo" inputmode="decimal" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label" for="motivo">@_L["Motivo (lo vede anche il cliente)"]</label>
                            <input class="form-control" id="motivo" name="motivo" maxlength="@Rimborso.LunghezzaMassimaMotivo" />
                        </div>
                        <button type="submit" class="btn btn-danger">@_L["Rimborsa"]</button>
                    </form>
                </div>
            </div>
        }
        @if (Model.Rimborsi.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header"><h3 class="card-title">@_L["Rimborsi"]</h3></div>
                <ul class="list-group list-group-flush">
                    @foreach (var rimborso in Model.Rimborsi)
                    {
                        <li class="list-group-item">
                            @Importo(rimborso.Importo) — @Model.StatoRimborso(rimborso.Stato)
                            @if (rimborso.IncassoOrfano)
                            {
                                <span class="text-secondary">(@_L["incasso non abbinato"])</span>
                            }
                            <br />
                            <small class="text-secondary">@rimborso.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm")@(rimborso.Motivo is { Length: > 0 } motivoRimborso ? " · " + motivoRimborso : null)</small>
                            @if (rimborso.Stato == StatoRimborso.InCorso)
                            {
                                <form method="post" asp-page-handler="VerificaRimborso" asp-route-id="@o.Id" class="mt-2">
                                    <input type="hidden" name="idRimborso" value="@rimborso.Id" />
                                    <button type="submit" class="btn btn-sm">@_L["Verifica l'esito"]</button>
                                </form>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
<p class="mt-3"><a href="/admin/negozio/ordini">@_L["Torna agli ordini"]</a></p>

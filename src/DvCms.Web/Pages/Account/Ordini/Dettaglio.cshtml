@page "/account/ordini/{id:guid}"
@model DvCms.Web.Pages.Account.Ordini.DettaglioModel
@using DvCms.Models.Negozio
@{
    ViewData["Titolo"] = _L["Ordine"] + " #" + Model.Ordine.Numero;
    string Importo(decimal valore) => $"{valore.ToString("N2", Model.Cultura)} {Model.Ordine.Valuta}";
    var o = Model.Ordine;
}
<h1>@_L["Ordine"] #@o.Numero</h1>
@if (Model.Messaggio is not null)
{
    <p role="status">@Model.Messaggio</p>
}
@if (Model.Errore is not null)
{
    <p class="errore" role="alert">@Model.Errore</p>
}
<p>@_L["Stato"]: <strong>@DvCms.Web.EtichetteOrdine.Stato(Model.Localizzatore, o.Stato)</strong> — @o.CreatoIlUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
<p>@_L["Pagamento"]: @DvCms.Web.EtichetteOrdine.Modalita(Model.Localizzatore, o.ModalitaPagamento)</p>
<table>
    <thead>
        <tr><th>@_L["Articolo"]</th><th>@_L["Prezzo"]</th><th>@_L["Quantità"]</th><th>@_L["Totale"]</th></tr>
    </thead>
    <tbody>
        @foreach (var riga in o.Righe)
        {
            <tr>
                <td>@riga.NomeProdotto@(riga.EtichettaVariante is { Length: > 0 } etichetta ? " — " + etichetta : null) <small>(@riga.Sku)</small></td>
                <td>@Importo(riga.PrezzoUnitarioLordo)</td>
                <td>@riga.Quantita</td>
                <td>@Importo(riga.Lordo)</td>
            </tr>
        }
        <tr>
            <td colspan="3">@o.NomeSpedizione</td>
            <td>@Importo(o.SpedizioneLorda)</td>
        </tr>
        @if (o.CommissioneLorda > 0)
        {
            <tr>
                <td colspan="3">@_L["Commissione contrassegno"]</td>
                <td>@Importo(o.CommissioneLorda)</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr><td colspan="3">@_L["Imponibile"]</td><td>@Importo(o.TotaleImponibile)</td></tr>
        <tr><td colspan="3">@_L["IVA"]</td><td>@Importo(o.TotaleIva)</td></tr>
        <tr><td colspan="3"><strong>@_L["Totale (IVA inclusa)"]</strong></td><td><strong>@Importo(o.TotaleLordo)</strong></td></tr>
    </tfoot>
</table>
@if (o.TotaleRimborsato > 0)
{
    <p>@_L["Rimborsato"]: <strong>@Importo(o.TotaleRimborsato)</strong></p>
}
@if (o.TipoSpedizione == TipoMetodoSpedizione.Ritiro)
{
    <p>@_L["Ritiro in sede."]</p>
}
else
{
    <address>
        @o.Destinatario<br />
        @o.IndirizzoRiga1<br />
        @if (!string.IsNullOrEmpty(o.IndirizzoRiga2))
        {
            @o.IndirizzoRiga2<br />
        }
        @o.Cap @o.Citta (@o.Paese)
    </address>
}
@if (o.PrenotazioneScadeIlUtc is { } scade && o.Stato == StatoOrdine.InAttesaDiPagamento && o.ModalitaPagamento == ModalitaPagamento.Online)
{
    <p>@_L["La merce è riservata per te fino alle"] @scade.ToString("HH:mm") UTC.</p>
}
@if (Model.AttendeBonifico)
{
    <section>
        <h2>@_L["Come pagare con bonifico"]</h2>
        <dl>
            <dt>@_L["Importo"]</dt><dd>@Importo(o.TotaleLordo)</dd>
            <dt>@_L["Intestatario"]</dt><dd>@Model.Offline.Intestatario</dd>
            <dt>IBAN</dt><dd>@(Model.Offline.Iban is null ? null : DvCms.Models.Negozio.Iban.Formatta(Model.Offline.Iban))</dd>
            @if (!string.IsNullOrEmpty(Model.Offline.Bic))
            {
                <dt>BIC/SWIFT</dt><dd>@Model.Offline.Bic</dd>
            }
            @if (!string.IsNullOrEmpty(Model.Offline.NomeBanca))
            {
                <dt>@_L["Banca"]</dt><dd>@Model.Offline.NomeBanca</dd>
            }
            <dt>@_L["Causale"]</dt><dd>@Model.Causale</dd>
        </dl>
        @if (o.PrenotazioneScadeIlUtc is { } entro)
        {
            <p>@_L["Effettua il bonifico entro il"] @entro.ToString("yyyy-MM-dd"): @_L["dopo questa data l'ordine viene annullato."]</p>
        }

        @if (!string.IsNullOrEmpty(Model.Offline.IstruzioniBonifico))
        {
            <p>@Model.Offline.IstruzioniBonifico</p>
        }

        <p>@_L["Appena riceviamo il pagamento l'ordine risulta pagato e ti scriviamo per confermarlo."]</p>
    </section>
}
@if (o.ModalitaPagamento == ModalitaPagamento.Contrassegno && o.Stato is StatoOrdine.DaSpedireContrassegno or StatoOrdine.Spedito)
{
    <p>@_L["Pagherai"] <strong>@Importo(o.TotaleLordo)</strong> @_L["al corriere alla consegna."]</p>
    @if (!string.IsNullOrEmpty(Model.Offline.IstruzioniContrassegno))
    {
        <p>@Model.Offline.IstruzioniContrassegno</p>
    }
}
@if (Model.UrlPagamento is not null)
{
    <p role="status"><a href="@Model.UrlPagamento.AbsoluteUri" rel="noopener">@(Model.ProviderAvviato == DvCms.Models.Negozio.NomiProviderPagamento.Nexi ? _L["Continua su Nexi per completare il pagamento"] : _L["Continua su PayPal per completare il pagamento"])</a></p>
}
else if (Model.PuoPagare)
{
    @if (Model.ProviderDisponibili.Count == 0)
    {
        <p>@_L["Il pagamento online non è disponibile per questo negozio."]</p>
    }

    @foreach (var provider in Model.ProviderDisponibili)
    {
        <form method="post" asp-page-handler="Paga" asp-route-id="@o.Id">
            <input type="hidden" name="provider" value="@provider" />
            @if (provider == DvCms.Models.Negozio.NomiProviderPagamento.Nexi)
            {
                <button type="submit">@(o.Stato == StatoOrdine.PagamentoFallito ? _L["Riprova a pagare con carta (Nexi)"] : _L["Paga con carta (Nexi)"])</button>
            }
            else
            {
                <button type="submit">@(o.Stato == StatoOrdine.PagamentoFallito ? _L["Riprova a pagare con PayPal"] : _L["Paga con PayPal"])</button>
            }
        </form>
    }
}
@if (Model.PuoAnnullare)
{
    <form method="post" asp-page-handler="Annulla" asp-route-id="@o.Id">
        <button type="submit">@_L["Annulla l'ordine"]</button>
    </form>
}
<nav><a href="/account/ordini">@_L["I miei ordini"]</a></nav>

@page "/account"
@model DvCms.Web.Pages.Account.IndexModel
@{
    ViewData["Titolo"] = _L["Il mio account"];
}
<h1>@_L["Il mio account"]</h1>
<p>@_L["Ciao"] <strong>@User.Identity?.Name</strong>.</p>
<p><a href="/account/carrello">@_L["Il tuo carrello"]</a></p>
<p><a href="/account/ordini">@_L["I miei ordini"]</a></p>
<form method="post" asp-page="/Account/Esci">
    <button type="submit">@_L["Esci"]</button>
</form>

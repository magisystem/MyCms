@page "/admin/platform/tenant/{id:guid}"
@model DvCms.Web.Areas.Platform.Pages.Tenant.DettaglioModel
@{
    var tenant = Model.Tenant!;
    ViewData["Titolo"] = tenant.Nome;
}
@if (Model.Messaggio is not null)
{
    <div class="alert alert-success" role="status">@Model.Messaggio</div>
}
@if (Model.ErroreDaMostrare is not null)
{
    <div class="alert alert-danger" role="alert">@Model.ErroreDaMostrare</div>
}
@if (Model.PasswordTemporanea is not null)
{
    <div class="alert alert-warning" role="alert" id="password-temporanea">
        <h4 class="alert-title">@_L["Amministratore creato"]</h4>
        <p>@_L["Comunica in modo sicuro queste credenziali a"] <strong>@Model.EmailNuovoAmministratore</strong>. @_L["La password temporanea viene mostrata una sola volta e andrà cambiata al primo accesso."]</p>
        <code class="fs-3 user-select-all">@Model.PasswordTemporanea</code>
    </div>
}

<div class="row row-cards">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    @_L["Tenant"]
                    @if (tenant.Primario)
                    {
                        <span class="badge bg-blue-lt ms-2">@_L["Primario"]</span>
                    }
                    @if (tenant.Stato == StatoTenant.Attivo)
                    {
                        <span class="badge bg-green-lt ms-2">@_L["Attivo"]</span>
                    }
                    else
                    {
                        <span class="badge bg-red-lt ms-2">@_L["Sospeso"]</span>
                    }
                </h3>
                <div class="card-actions">
                    <a href="/admin/platform/tenant/@tenant.Id/email" class="btn"><i class="ti ti-mail"></i> @_L["Email"]</a>
                    <a href="/admin/platform/tenant" class="btn btn-link">@_L["Torna all'elenco"]</a>
                </div>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Rinomina" asp-route-id="@tenant.Id" class="row g-2 align-items-end">
                    <div class="col">
                        <label class="form-label" for="NomeTenant">@_L["Nome del tenant"]</label>
                        <input class="form-control" id="NomeTenant" name="nome" value="@tenant.Nome" maxlength="200" required />
                    </div>
                    <div class="col-auto"><button type="submit" class="btn btn-primary">@_L["Salva"]</button></div>
                </form>
                @if (!tenant.Primario)
                {
                    <div class="mt-3">
                        @if (tenant.Stato == StatoTenant.Attivo)
                        {
                            <form method="post" asp-page-handler="Sospendi" asp-route-id="@tenant.Id">
                                <button type="submit" class="btn btn-outline-danger">@_L["Sospendi il tenant"]</button>
                                <span class="form-hint ms-2">@_L["Un tenant sospeso non è più raggiungibile dai suoi domini."]</span>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Riattiva" asp-route-id="@tenant.Id">
                                <button type="submit" class="btn btn-outline-success">@_L["Riattiva il tenant"]</button>
                            </form>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header"><h3 class="card-title">@_L["Siti e domini"]</h3></div>
            <div class="card-body">
                @foreach (var sito in tenant.Siti)
                {
                    <div class="border rounded p-3 mb-3">
                        <form method="post" asp-page-handler="ModificaSito" asp-route-id="@tenant.Id" class="row g-2 align-items-end">
                            <input type="hidden" name="idSito" value="@sito.Id" />
                            <div class="col-md">
                                <label class="form-label">@_L["Nome del sito"]</label>
                                <input class="form-control" name="nome" value="@sito.Nome" maxlength="200" required />
                            </div>
                            <div class="col-md">
                                <label class="form-label">@_L["Fuso orario"]</label>
                                <input class="form-control" name="fusoOrario" value="@sito.FusoOrario" maxlength="64" />
                            </div>
                            <div class="col-md-auto">
                                <label class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" name="attivo" value="true" @(sito.Stato == StatoSito.Attivo ? "checked" : null) />
                                    <span class="form-check-label">@_L["Sito attivo"]</span>
                                </label>
                            </div>
                            <div class="col-md-auto"><button type="submit" class="btn btn-primary">@_L["Salva"]</button></div>
                        </form>

                        <table class="table table-sm mt-3 mb-2">
                            <thead>
                                <tr>
                                    <th>@_L["Dominio"]</th>
                                    <th>@_L["Verifica"]</th>
                                    <th>@_L["Stato"]</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dominio in sito.Domini)
                                {
                                    <tr>
                                        <td>
                                            @dominio.Host
                                            @if (dominio.SoloSviluppo)
                                            {
                                                <span class="badge bg-yellow-lt ms-1">@_L["Solo sviluppo"]</span>
                                            }
                                        </td>
                                        <td>
                                            @if (dominio.VerificatoIlUtc is { } verificato)
                                            {
                                                <span class="text-secondary">@verificato.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC @(dominio.VerificatoDa is null ? string.Empty : "- " + dominio.VerificatoDa)</span>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="VerificaDominio" asp-route-id="@tenant.Id" class="d-inline">
                                                    <input type="hidden" name="idDominio" value="@dominio.Id" />
                                                    <span class="badge bg-orange-lt me-2">@_L["Da verificare"]</span>
                                                    <button type="submit" class="btn btn-sm">@_L["Ho verificato il possesso"]</button>
                                                </form>
                                            }
                                        </td>
                                        <td>
                                            @if (dominio.Attivo)
                                            {
                                                <span class="badge bg-green-lt">@_L["Attivo"]</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-lt">@_L["Disattivato"]</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <form method="post" asp-page-handler="DominioAttivo" asp-route-id="@tenant.Id" class="d-inline">
                                                <input type="hidden" name="idDominio" value="@dominio.Id" />
                                                <input type="hidden" name="attivo" value="@((!dominio.Attivo).ToString().ToLowerInvariant())" />
                                                <button type="submit" class="btn btn-sm">@(dominio.Attivo ? _L["Disattiva"] : _L["Riattiva"])</button>
                                            </form>
                                            @if (dominio.Attivo && dominio.VerificatoIlUtc is not null && !dominio.SoloSviluppo)
                                            {
                                                <a href="@Model.IndirizzoAdmin(dominio.Host)" class="btn btn-sm btn-outline-primary" rel="noopener">@_L["Apri l'admin"]</a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="mb-3">
                            <div class="form-label">@_L["Lingue del sito"]</div>
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @foreach (var lingua in sito.Lingue)
                                {
                                    <span class="badge @(lingua.Predefinita ? "bg-blue-lt" : "bg-secondary-lt")">
                                        @lingua.Nome (@lingua.Codice)@(lingua.Predefinita ? " - " + _L["predefinita"] : string.Empty)
                                    </span>
                                    @if (!lingua.Predefinita)
                                    {
                                        <form method="post" asp-page-handler="LinguaPredefinita" asp-route-id="@tenant.Id" class="d-inline">
                                            <input type="hidden" name="idSito" value="@sito.Id" />
                                            <input type="hidden" name="lingua" value="@lingua.Codice" />
                                            <button type="submit" class="btn btn-sm">@_L["Rendi predefinita"]</button>
                                        </form>
                                        <form method="post" asp-page-handler="DisabilitaLingua" asp-route-id="@tenant.Id" class="d-inline">
                                            <input type="hidden" name="idSito" value="@sito.Id" />
                                            <input type="hidden" name="lingua" value="@lingua.Codice" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">@_L["Disabilita"]</button>
                                        </form>
                                    }
                                }
                                @{
                                    var daAggiungere = tenant.LingueDisponibili.Where(l => sito.Lingue.All(x => x.Codice != l.Codice)).ToList();
                                }
                                @if (daAggiungere.Count > 0)
                                {
                                    <form method="post" asp-page-handler="AbilitaLingua" asp-route-id="@tenant.Id" class="d-inline-flex gap-1">
                                        <input type="hidden" name="idSito" value="@sito.Id" />
                                        <select name="lingua" class="form-select form-select-sm" aria-label="@_L["Lingua da abilitare"]">
                                            @foreach (var l in daAggiungere)
                                            {
                                                <option value="@l.Codice">@l.Nome (@l.Codice)</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm">@_L["Abilita"]</button>
                                    </form>
                                }
                            </div>
                            <div class="form-hint">@_L["La lingua predefinita non ha prefisso nell'indirizzo, le altre sì (ad esempio /en/pagina)."]</div>
                        </div>

                        <form method="post" asp-page-handler="NuovoDominio" asp-route-id="@tenant.Id" class="row g-2 align-items-end">
                            <input type="hidden" name="idSito" value="@sito.Id" />
                            <div class="col-md">
                                <label class="form-label">@_L["Nuovo dominio"]</label>
                                <input class="form-control" name="host" maxlength="253" required />
                            </div>
                            <div class="col-md-auto">
                                <label class="form-check mb-2">
                                    <input type="checkbox" class="form-check-input" name="verificato" value="true" />
                                    <span class="form-check-label">@_L["Ho verificato il possesso del dominio"]</span>
                                </label>
                            </div>
                            <div class="col-md-auto"><button type="submit" class="btn">@_L["Aggiungi dominio"]</button></div>
                        </form>
                    </div>
                }

                <form method="post" asp-page-handler="NuovoSito" asp-route-id="@tenant.Id" class="row g-2 align-items-end">
                    <div class="col-md">
                        <label class="form-label">@_L["Nuovo sito"]</label>
                        <input class="form-control" name="nome" maxlength="200" required />
                    </div>
                    <div class="col-md">
                        <label class="form-label">@_L["Fuso orario"]</label>
                        <input class="form-control" name="fusoOrario" value="Europe/Rome" maxlength="64" />
                    </div>
                    <div class="col-md-auto"><button type="submit" class="btn">@_L["Crea sito"]</button></div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header"><h3 class="card-title">@_L["Account del tenant"]</h3></div>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>@_L["Email"]</th>
                            <th>@_L["Nome"]</th>
                            <th>@_L["Ruolo"]</th>
                            <th>@_L["Stato"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var account in tenant.Account)
                        {
                            <tr>
                                <td>@account.Email</td>
                                <td>@account.NomeVisualizzato</td>
                                <td>
                                    @account.Ruolo
                                    @if (account.DeveCambiarePassword)
                                    {
                                        <span class="badge bg-orange-lt ms-1">@_L["Password temporanea"]</span>
                                    }
                                </td>
                                <td>
                                    @if (account.Stato == StatoUtenza.Attiva)
                                    {
                                        <span class="badge bg-green-lt">@_L["Attivo"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">@_L["Disabilitato"]</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (account.Ruolo == RuoloUtenza.Utente && account.Stato == StatoUtenza.Attiva)
                                    {
                                        <form method="post" asp-page-handler="Promuovi" asp-route-id="@tenant.Id" class="d-inline">
                                            <input type="hidden" name="idUtenza" value="@account.Id" />
                                            <button type="submit" class="btn btn-sm">@_L["Promuovi ad amministratore"]</button>
                                        </form>
                                    }
                                    @if (account.Ruolo == RuoloUtenza.TenantAdmin && account.DeveCambiarePassword && account.Stato == StatoUtenza.Attiva && tenant.EmailConfigurata)
                                    {
                                        <form method="post" asp-page-handler="InviaInvito" asp-route-id="@tenant.Id" class="d-inline">
                                            <input type="hidden" name="idUtenza" value="@account.Id" />
                                            <button type="submit" class="btn btn-sm">@_L["Invia l'invito"]</button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="AccountAttivo" asp-route-id="@tenant.Id" class="d-inline">
                                        <input type="hidden" name="idUtenza" value="@account.Id" />
                                        <input type="hidden" name="attiva" value="@((account.Stato != StatoUtenza.Attiva).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="btn btn-sm">@(account.Stato == StatoUtenza.Attiva ? _L["Disabilita"] : _L["Riabilita"])</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body border-top">
                <form method="post" asp-page-handler="NuovoAmministratore" asp-route-id="@tenant.Id" class="row g-2 align-items-end" autocomplete="off">
                    <div class="col-12">
                        <label class="form-check">
                            <input type="checkbox" class="form-check-input" name="conInvito" value="true" checked="@tenant.EmailConfigurata" disabled="@(!tenant.EmailConfigurata)" />
                            <span class="form-check-label">@_L["Invia un invito via email (l'amministratore sceglie da sé la password)"]</span>
                        </label>
                        @if (!tenant.EmailConfigurata)
                        {
                            <div class="form-hint">@_L["Per usare l'invito configura prima il canale email del tenant."]</div>
                        }
                    </div>
                    <div class="col-md">
                        <label class="form-label">@_L["Email del nuovo amministratore"]</label>
                        <input type="email" class="form-control" name="email" maxlength="254" required />
                    </div>
                    <div class="col-md">
                        <label class="form-label">@_L["Nome visualizzato"]</label>
                        <input class="form-control" name="nomeVisualizzato" maxlength="200" required />
                    </div>
                    <div class="col-md-auto"><button type="submit" class="btn btn-primary">@_L["Crea amministratore"]</button></div>
                </form>
                <div class="form-hint mt-2">@_L["Senza invito viene generata una password temporanea, mostrata una sola volta."]</div>
            </div>
        </div>
    </div>
</div>

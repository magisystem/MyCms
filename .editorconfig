root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Stile C#: namespace con ambito di file, nomi espliciti, campi privati con prefisso _
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning

dotnet_naming_rule.costanti_pascal.symbols = costanti
dotnet_naming_rule.costanti_pascal.style = pascal_case
dotnet_naming_rule.costanti_pascal.severity = warning
dotnet_naming_symbols.costanti.applicable_kinds = field
dotnet_naming_symbols.costanti.required_modifiers = const
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.campi_privati_con_trattino.symbols = campi_privati
dotnet_naming_rule.campi_privati_con_trattino.style = prefisso_trattino
dotnet_naming_rule.campi_privati_con_trattino.severity = warning
dotnet_naming_symbols.campi_privati.applicable_kinds = field
dotnet_naming_symbols.campi_privati.applicable_accessibilities = private
dotnet_naming_style.prefisso_trattino.required_prefix = _
dotnet_naming_style.prefisso_trattino.capitalization = camel_case

[*.{cshtml,razor}]
indent_size = 4

# Migrazioni EF Core generate dagli strumenti: non soggette alle regole di stile e agli analyzer.
[**/DvCms.SqlServer/Migrazioni/*.cs]
generated_code = true
